rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /transactions/{transactionId} {
      allow read: if request.auth != null;

      allow create:
        if request.auth != null
        && (
          request.resource.data.ownerUid == request.auth.uid
          || request.resource.data.createdBy == request.auth.uid
        );

      allow update:
        if request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || resource.data.createdBy == request.auth.uid
        )
        && (
          !request.resource.data.keys().hasAny(['ownerUid'])
          || request.resource.data.ownerUid == request.auth.uid
        );

      allow delete:
        if request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || resource.data.createdBy == request.auth.uid
        );
    }

    match /challengeCells/{cellId} {
      allow read: if request.auth != null;

      allow create:
        if request.auth != null
        && (
          request.resource.data.ownerUid == request.auth.uid
          || request.resource.data.claimedBy == request.auth.uid
        );

      allow update:
        if request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || resource.data.claimedBy == request.auth.uid
        )
        && (
          request.resource.data.ownerUid == request.auth.uid
          || request.resource.data.claimedBy == request.auth.uid
        );

      allow delete:
        if request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || resource.data.claimedBy == request.auth.uid
        );
    }

    match /challengeSettings/{documentId} {
      allow read, write: if request.auth != null;
    }

    match /challengeHistory/{documentId} {
      allow read: if request.auth != null;
      allow create, update:
        if request.auth != null
        && (
          request.resource.data.completedBy == request.auth.uid
          || request.resource.data.person != null
        );
    }

    match /settings/{documentId} {
      allow read, write: if request.auth != null;
    }
  }
}
